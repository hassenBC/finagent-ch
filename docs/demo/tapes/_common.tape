Set Shell "bash"
Set FontSize 22
Set Width 1920
Set Height 1080
Set Padding 40
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Framerate 30
Set WindowBar Colorful
Set WindowBarSize 44
Set BorderRadius 12
Set Margin 0
Hide
Type "export PS1='$ ' && export PATH=$FINAGENT_ROOT/.venv/bin:$PATH && alias docker=docker.exe && cd $FINAGENT_ROOT && clear"
Enter
Show
