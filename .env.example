# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://finagent:finagent@localhost:5432/finagent

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Phase 9: vLLM on vast.ai (any non-empty value unless you start vLLM with --api-key)
VLLM_API_KEY=EMPTY

# vast.ai offer filter. The vast API key itself lives in ~/.config/vastai (set via `vastai set api-key`).
VAST_MAX_DPH=0.40
